  "requirements": {
    "metrics": [
      {
        "id": "food_productivity_2025",
        "name": "Food manufacturing labor productivity index",
        "meaning": "Published 2025 labor productivity index for NAICS 311, all workers, in 2017=100 units.",
        "unit": "index (2017=100)"
      },
      {
        "id": "food_productivity_yoy_change",
        "name": "Food manufacturing year-over-year change",
        "meaning": "Relative change in the published productivity index from 2024 to 2025, calculated from the two annual levels.",
        "unit": "fraction"
      },
      {
        "id": "food_productivity_change_since_2020",
        "name": "Food manufacturing change since 2020",
        "meaning": "Relative change in the published productivity index from 2020 to 2025, calculated from the two annual levels.",
        "unit": "fraction"
      }
    ],
    "scenario": {
      "default": "Base",
      "dimensions": [
        {
          "id": "productivity_multiplier",
          "meaning": "Illustrative scenario multiplier applied to the published 2025 index; not a forecast."
        }
      ],
      "rows": [
        {
          "name": "Base",
          "assumptions": {
            "productivity_multiplier": 1.0
          }
        },
        {
          "name": "Higher",
          "assumptions": {
            "productivity_multiplier": 1.05
          }
        },
        {
          "name": "Lower",
          "assumptions": {
            "productivity_multiplier": 0.95
          }
        }
      ],
      "projections": [
        {
          "id": "projected_productivity_index",
          "meaning": "Published 2025 food manufacturing productivity index scaled by the selected illustrative assumption.",
          "unit": "index (2017=100)"
        }
      ]
    },
    "charts": [
      {
        "id": "manufacturing_subindustry_2025",
        "meaning": "Compare published 2025 productivity index levels for five 3-digit manufacturing industries. Do not combine levels across industries or representations.",
        "unit": "index (2017=100)"
      }
    ],
    "minimum_comments": 2,
