      "MRTSSM446USS",
      "MRTSSM448USS"
    ],
    "selected_periods": [
      "2023-01",
      "2024-12"
    ],
    "observed_seed_rows": 144,
    "benchmark_raw_rows": 100000,
    "raw_rows_are_observed_firms": false,
    "expansion": "Integer-dollar partition: each observed amount split across deterministic synthetic shards; source totals preserved.",
    "units": "USD converted from source millions of dollars",
    "dimensions": "Published disjoint selected retail categories"
  }
