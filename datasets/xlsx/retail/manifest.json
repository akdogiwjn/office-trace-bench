    "source_artifact": "sources/xlsx/retail_fred.csv",
    "source_sha256": "bd94274eb921b5331260f38445808c7d78895fe32e7b79cfdcf456a0add0659c",
    "series": [
      "MRTSSM441USS",
      "MRTSSM442USS",
      "MRTSSM443USS",
