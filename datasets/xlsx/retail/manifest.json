{
  "schema_version": "office-dataset-v1",
  "kind": "xlsx",
  "dataset_id": "retail",
  "domain": "retail",
  "task": "Enhance the existing retail operations benchmark workbook",
  "workbook": "monthly_operations_template.xlsx",
  "output_workbook": "monthly_operations_report.xlsx",
  "requirements": {
    "summary_sheet": "Executive_Summary",
    "base_sheets": [
      "Raw_Data",
      "Monthly_Summary",
      "Category_Summary",
      "Growth_Summary",
      "Sales_Mix",
      "Source_Summary",
      "Reconciliation"
    ],
    "raw_sheets": [
      "Raw_Data"
    ],
    "minimum_bytes": 1000000,
    "minimum_formula_count": 50,
    "metrics": [
      {
        "name": "Latest Month Selected-category Sales",
        "cell": "B5",
        "required_references": [
          "Monthly_Summary!B25"
        ],
        "font_color": "008000",
        "number_format": "$#,##0"
      },
      {
        "name": "Month-over-Month Growth",
        "cell": "B6",
        "required_references": [
          "Growth_Summary!B25"
        ],
        "font_color": "008000",
        "number_format": "0.0%"
      },
      {
        "name": "Year-over-Year Growth",
        "cell": "B7",
        "required_references": [
          "Growth_Summary!C25"
        ],
        "font_color": "008000",
        "number_format": "0.0%"
      },
      {
        "name": "Largest Selected Category",
        "cell": "B8",
        "required_references": [
          "Category_Summary!D2"
        ],
        "font_color": "008000"
      },
      {
        "name": "Reconciliation Status",
        "cell": "B9",
        "required_references": [
          "Reconciliation!B15"
        ],
        "font_color": "008000",
        "prompt_instruction": "cross-sheet formula returning PASS when Reconciliation!B15 is PASS, otherwise REVIEW."
      }
    ],
    "scenario": {
      "selector_cell": "B12",
      "default": "Base",
      "table_columns": {
        "D": "Scenario",
        "E": "Sales price multiplier",
        "F": "Sales volume multiplier"
      },
      "rows": [
        {
          "name": "Base",
          "cells": {
            "D13": "Base",
            "E13": 1.0,
            "F13": 1.0
          }
        },
        {
          "name": "Upside",
          "cells": {
            "D14": "Upside",
            "E14": 1.08,
            "F14": 1.05
          }
        },
        {
          "name": "Downside",
          "cells": {
            "D15": "Downside",
            "E15": 0.93,
            "F15": 0.95
          }
        }
      ],
      "formula_metrics": [
        {
          "name": "Selected Sales price multiplier",
          "cell": "B13",
          "required_references": [
            "B12"
          ],
          "meaning": "Look up selected multiplier",
          "font_color": "000000"
        },
        {
          "name": "Selected Sales volume multiplier",
          "cell": "B14",
          "required_references": [
            "B12"
          ],
          "meaning": "Look up selected multiplier",
          "font_color": "000000"
        },
        {
          "name": "Projected Sales at Base Prices",
          "cell": "B15",
          "required_references": [
            "B5",
            "B14"
          ],
          "meaning": "Multiply the referenced KPI by selected scenario multipliers",
          "font_color": "000000"
        },
        {
          "name": "Projected Sales Revenue",
          "cell": "B16",
          "required_references": [
            "B5",
            "B13",
            "B14"
          ],
          "meaning": "Multiply the referenced KPI by selected scenario multipliers",
          "font_color": "000000"
        }
      ]
    },
    "charts": [
      {
        "id": "monthly_sales",
        "description": "a monthly sales trend",
        "required_references": [
          "Monthly_Summary!"
        ]
      },
      {
        "id": "category_mix",
        "description": "a selected-category sales mix",
        "required_references": [
          "Sales_Mix!"
        ]
      }
    ],
    "minimum_conditional_formats": 2,
    "minimum_comments": 2,
    "recalc_timeout": 180
  },
  "publish_files": [
    {
      "input": "prepared_monthly_operations_summary.csv",
      "output": "monthly_operations_summary.csv",
      "sha256": "6772ca43cb92ce91e0fbb4978c4232ded8fb4160c1b7f6fb0fed6c2d4ec504aa"
    },
    {
      "input": "prepared_reconciliation_summary.csv",
      "output": "reconciliation_summary.csv",
      "sha256": "20665d5fe7446c07f4bc802bfdd8b71a2a1167465c7eade45d547851c09a9aef"
    }
  ],
  "required_outputs": [
    "monthly_operations_report.xlsx",
    "monthly_operations_summary.csv",
    "reconciliation_summary.csv",
    "formula_recalc.json",
    "business_verification.json",
    "xlsx_enhancement_summary.json"
  ],
  "input_files": {
    "input/dataset_sources.md": "7a3e5b098c2f766eefb15e7392638db089eeb61e2c244e90d30ead34968336d7",
    "input/monthly_operations_template.xlsx": "93095121928adbc03f0e134862716d5fd8b0cf281b773ce25abb4a2f76dfd052",
    "input/prepared_monthly_operations_summary.csv": "6772ca43cb92ce91e0fbb4978c4232ded8fb4160c1b7f6fb0fed6c2d4ec504aa",
    "input/prepared_reconciliation_summary.csv": "20665d5fe7446c07f4bc802bfdd8b71a2a1167465c7eade45d547851c09a9aef",
    "input/template_manifest.json": "a424c7fdf64661968bb111503e865665d69763be1bf485becf32392a6ebe315e"
  },
  "expected_file": "expected.json",
  "expected_sha256": "f9fb6d1edf20f8f358af1dd6bd7af9ebd8797d4e135661cb3b8e4fb15f6df7c4",
  "prompt_template": "xlsx.txt",
  "prompt_template_sha256": "4457c1646510aa458a900aaf967f351de923a0877092a3f8e47f314c68657506",
  "prompt_contract": {
    "task_subject": "Census MRTS retail January 2023–December 2024 benchmark workbook",
    "raw_record_count": 100000,
    "original_chart_count": 2,
    "metadata_files": [
      "template_manifest.json",
