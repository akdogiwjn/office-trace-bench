+ws.merge_cells("A2:F2")
+
+# --- KPI section ---
+ws["A4"] = "Key Performance Indicators"
+ws["A4"].font = section_font
+for c in "ABCDEF":
+    ws[f"{c}4"].fill = section_fill
+ws.merge_cells("A4:F4")
+
+kpi = [
+    ("A5", "Total Trips", "B5", "=Reconciliation!B10", green_font, "#,##0"),
+    ("A6", "Total Fare Revenue", "B6", "=Reconciliation!B14", green_font, "$#,##0.00"),
+    ("A7", "Overall Average Fare", "B7", "='Hourly_Summary'!B34", green_font, "$#,##0.00"),
+    ("A8", "Removal Rate", "B8", "=Reconciliation!B5", green_font, "0.0%"),
+]
+for lab_cell, lab, val_cell, formula, fnt, numfmt in kpi:
+    ws[lab_cell] = lab
+    ws[lab_cell].font = label_font
+    ws[val_cell] = formula
+    ws[val_cell].font = fnt
+    ws[val_cell].number_format = numfmt
+
+ws["A9"] = "Reconciliation Status"
+ws["A9"].font = label_font
+ws["B9"] = ('=IF(AND(Reconciliation!B24="YES - Consistent",'
+            'Reconciliation!B25="YES - Consistent"),"PASS","REVIEW")')
+ws["B9"].font = green_font
+ws["B9"].alignment = Alignment(horizontal="left")
+
+# --- Scenario section ---
+ws["A11"] = "Scenario Analysis"
+ws["A11"].font = section_font
+for c in "ABCDEF":
+    ws[f"{c}11"].fill = section_fill
+ws.merge_cells("A11:F11")
+
+ws["A12"] = "Selected Scenario"
+ws["A12"].font = label_font
+ws["B12"] = "Base"
+ws["B12"].font = blue_font
+ws["B12"].fill = fill("FFFFF2CC")
+ws["B12"].border = box
+ws["B12"].alignment = Alignment(horizontal="left")
+
+ws["A13"] = "Selected Fare Multiplier"
