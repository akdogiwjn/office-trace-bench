  "runtime_case": "OFFICE-XLSX-RETAIL",
  "requirements": {
    "metrics": [
      {
        "id": "adjusted_sales",
        "name": "Adjusted retail and food services sales",
        "meaning": "Published total retail and food services seasonally adjusted sales for August 2026. Use the total, not a sum of overlapping categories.",
        "unit": "USD million"
      },
      {
        "id": "monthly_growth",
        "name": "Month-over-month growth",
        "meaning": "Relative change in the adjusted total from July to August 2026; compute from sales levels rather than rounded published percentages.",
        "unit": "fraction"
      },
      {
        "id": "annual_growth",
        "name": "Year-over-year growth",
        "meaning": "Relative change in the adjusted total from August 2025 to August 2026; compute from sales levels.",
        "unit": "fraction"
      }
    ],
    "scenario": {
      "default": "Base",
      "dimensions": [
        {
          "id": "sales_multiplier",
          "meaning": "Hypothetical sales level multiplier, not a Census forecast"
        }
      ],
      "rows": [
        {
          "name": "Base",
          "assumptions": {
            "sales_multiplier": 1
          }
        },
        {
          "name": "Higher",
          "assumptions": {
            "sales_multiplier": 1.04
          }
        },
        {
          "name": "Lower",
          "assumptions": {
            "sales_multiplier": 0.96
          }
        }
      ],
      "projections": [
        {
          "id": "projected_sales",
          "meaning": "Adjusted sales scaled by the selected sales multiplier",
          "unit": "USD million"
        }
      ]
    },
    "charts": [
      {
        "id": "adjusted_trend",
        "meaning": "June, July and August 2026 adjusted total sales; chronological order",
        "unit": "USD million"
      }
    ],
    "minimum_comments": 2,
    "minimum_conditional_formats": 2,
    "recalc_timeout": 180
  },
