{
  "schema_version": "office-dataset-v1",
  "kind": "xlsx",
  "dataset_id": "hr",
  "domain": "workforce",
  "task": "Enhance the BLS OEWS selected workforce benchmark workbook",
  "workbook": "workforce_template.xlsx",
  "output_workbook": "workforce_report.xlsx",
  "requirements": {
    "summary_sheet": "Executive_Summary",
    "base_sheets": [
      "Raw_Data",
      "Occupation_Summary",
      "Employment_Summary",
      "Wage_Summary",
      "Segment_Summary",
      "Employment_Mix",
      "Reconciliation"
    ],
    "raw_sheets": [
      "Raw_Data"
    ],
    "minimum_bytes": 1000000,
    "minimum_formula_count": 20,
    "metrics": [
      {
        "name": "Selected Employment",
        "cell": "B5",
        "required_references": [
          "Employment_Summary!B2"
        ],
        "font_color": "008000",
        "number_format": "#,##0"
      },
      {
        "name": "Employment-weighted Annual Mean Wage",
        "cell": "B6",
        "required_references": [
          "Wage_Summary!B2"
        ],
        "font_color": "008000",
        "number_format": "$#,##0.00"
      },
      {
        "name": "Employment-weighted Occupation Median Proxy",
        "cell": "B7",
        "required_references": [
          "Wage_Summary!B3"
        ],
        "font_color": "008000",
        "number_format": "$#,##0.00"
      },
      {
        "name": "Highest Employment Selected Occupation",
        "cell": "B8",
        "required_references": [
          "Occupation_Summary!H2"
        ],
        "font_color": "008000"
      },
      {
        "name": "Reconciliation Status",
        "cell": "B9",
        "required_references": [
          "Reconciliation!B15"
        ],
        "font_color": "008000"
      }
    ],
    "scenario": {
      "selector_cell": "B12",
      "default": "Base",
      "table_columns": {
        "D": "Scenario",
        "E": "Wage multiplier",
        "F": "Headcount multiplier"
      },
      "rows": [
        {
          "name": "Base",
          "cells": {
            "D13": "Base",
            "E13": 1.0,
            "F13": 1.0
          }
        },
        {
          "name": "Upside",
          "cells": {
            "D14": "Upside",
            "E14": 1.08,
            "F14": 1.05
          }
        },
        {
          "name": "Downside",
          "cells": {
            "D15": "Downside",
            "E15": 0.93,
            "F15": 0.95
          }
        }
      ],
      "formula_metrics": [
        {
          "name": "Selected wage multiplier",
          "cell": "B13",
          "required_references": [
            "B12"
          ],
          "meaning": "Look up selected wage multiplier",
          "font_color": "000000"
        },
        {
          "name": "Selected headcount multiplier",
          "cell": "B14",
          "required_references": [
            "B12"
          ],
          "meaning": "Look up selected headcount multiplier",
          "font_color": "000000"
        },
        {
          "name": "Projected Employment",
          "cell": "B15",
          "required_references": [
            "B5",
            "B14"
          ],
          "meaning": "Multiply selected employment by headcount multiplier",
          "font_color": "000000"
        },
        {
          "name": "Projected Estimated Payroll",
          "cell": "B16",
          "required_references": [
            "B5",
            "B6",
            "B13",
            "B14"
          ],
          "meaning": "Multiply employment by annual mean wage and both scenario multipliers",
          "font_color": "000000"
        }
      ]
    },
    "charts": [
      {
        "id": "employment_mix",
        "description": "employment mix of selected occupations",
        "required_references": [
          "Employment_Mix!"
        ]
      },
      {
        "id": "wage_distribution",
        "description": "annual mean and median wage comparison of selected occupations",
        "required_references": [
          "Occupation_Summary!"
        ]
      }
    ],
    "minimum_conditional_formats": 2,
    "minimum_comments": 2,
    "recalc_timeout": 180
