tion import DataValidation\n\nROOT = Path(__file__).resolve().parents[1]\nINPUT = ROOT / 'input/labor-productivity-detailed-industries.xlsx'\nOUTPUT = ROOT / 'output/industry_productivity_enhanced.xlsx'\nFEATURES = ROOT / 'output/workbook_features.json'\n\nBLUE = 'FF0000FF'\nGREEN = 'FF008000'\nBLACK = 'FF000000'\n\nTITLE_FILL = PatternFill('solid', start_color='1F4E79')\nSECTION_FILL = PatternFill('solid', start_color='D9E2F3')\nNOTE_FILL = PatternFill('solid', start_color='FFF2CC')\nHEADER_FONT = Font(name='Arial', size=11, bold=True, color='FFFFFFFF')\nTITLE_FONT = Font(name='Arial', size=14, bold=True, color='FFFFFFFF')\nSECTION_FONT = Font(name='Arial', size=11, bold=True, color='FF1F4E79')\nNOTE_FONT = Font(name='Arial', size=9, italic=True, color='FF404040')\nWRAP = Alignment(wrap_text=True, vertical='top')\nLEFT = Alignment(horizontal='left', vertical='center')\nRIGHT = Alignment(horizontal='right', vertical='center')\n\n\ndef font(color=BLACK, bold=False, italic=False, size=11):\n    return Font(name='Arial', size=size, bold=bold, italic=italic, color=color)\n\n\ndef build_summary(wb):\n    ws = wb.create_sheet('Summary', 0)\n    widths = {'A': 52, 'B': 30, 'C': 18, 'D': 34, 'E': 12}\n    for col, w in widths.items():\n        ws.column_dimensions[col].width = w\n\n    # Title block\n    ws.merge_cells('A1:E1')\n    ws['A1'] = 'Labor Productivity in Food Manufacturing - BLS Detailed Industries Analysis'\n    ws['A1'].font = TITLE_FONT\n    ws['A1'].fill = TITLE_FILL\n    ws['A1'].alignment = Alignment(horizontal='left', vertical='center')\n    ws.row_dimensions[1].height = 24\n    ws.merge_cells('A2:E2')\n    ws['A2'] = ('Source: U.S. Bureau of Labor Statistics, Office of Productivity and Technology, '\n                'labor-productivity-detailed-industries.xlsx, Annual tab (released September 24, 2026).')\n    ws['A2'].font = font(italic=True, size=10)\n    ws['A2'].alignment = WRAP\n    ws.row_dimensions[2].height = 28\n    ws.merge_cells('A3:E3')\n    ws['A3'] = ('The MachineReadable tab holds the same published series in long form; '\n                'all calculations below use the Annual tab only. Suppression markers (N.A.) are retained.')\n    ws['A3'].font = font(italic=True, size=10)\n    ws['A3'].alignment = WRAP\n    ws.row_dimensions[3].height = 28\n\n    # Section 1: published metrics\n    ws.merge_cells('A5:E5')\n    ws['A5'] = 'PUBLISHED METRICS - NAICS 311 Food Manufacturing, All workers'\n    ws['A5'].font = SECTION_FONT\n    ws['A5'].fill = SECTION_FILL\n    ws['A5'].alignment = Alignment(horizontal='left', vertical='center')\n    for col, text in (('A6', 'Metric'), ('B6', 'Unit'), ('C6', 'Value')):\n        ws[col].font = HEADER_FONT\n        ws[col].fill = TITLE_FILL\n        ws[col].alignment = LEFT\n\n    ws['A7'] = 'Labor productivity index, 2025'\n    ws['A7'].font = font()\n    ws['A7'].alignment = LEFT\n    ws['B7'] = 'index (2017=100)'\n    ws['B7'].font = font()\n    ws['B7'].alignment = LEFT\n    ws['C7'] = '=Annual!AT487'\n    ws['C7'].font = font(color=GREEN)\n    ws['C7'].number_format = '0.000'\n    ws['C7'].alignment = RIGHT\n    ws['C7'].comment = Comment(\n        'Source: Annual tab, NAICS 311 Food manufacturing, All workers, Labor productivity, '\n        'Units \"Index (2017=100)\", year 2025 (cell Annual!AT487). '\n        'Published level; MachineReadable tab carries the same series in long form.',\n        'Productivity Analysis')\n\n    ws['A8'] = 'Year-over-year change, 2024 to 2025'\n    ws['A8'].font = font()\n    ws['A8'].alignment = LEFT\n    ws['B8'] = 'fraction'\n    ws['B8'].font = font()\n    ws['B8'].alignment = LEFT\n    ws['C8'] = '=(Annual!AT487-Annual!AS487)/Annual!AS487'\n    ws['C8'].font = font(color=GREEN)\n    ws['C8'].number_format = '0.0000'\n    ws['C8'].alignment = RIGHT\n    ws['C8'].comment = Comment(\n        'Formula: (2025 index - 2024 index) / 2024 index using published Annual tab levels '\n        '(Annual!AT487 and Annual!AS487). Not seasonally 