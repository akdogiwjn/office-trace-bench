ER_FONT\n        ws[col].fill = TITLE_FILL\n        ws[col].alignment = LEFT\n\n    assumptions = [('Base', 1.0, 'B14', 14), ('Higher', 1.05, 'B15', 15), ('Lower', 0.95, 'B16', 16)]\n    for name, value, cell, row in assumptions:\n        ws[f'A{row}'] = name\n        ws[f'A{row}'].font = font()\n        ws[f'A{row}'].alignment = LEFT\n        ws[cell] = value\n        ws[cell].font = font(color=BLUE)\n        ws[cell].number_format = '0.00'\n        ws[cell].alignment = RIGHT\n\n    ws['A18'] = 'Projected productivity index (2025 index x selected multiplier)'\n    ws['A18'].font = font(bold=True)\n    ws['A18'].alignment = LEFT\n    ws['B18'] = 'index (2017=100)'\n    ws['B18'].font = font()\n    ws['B18'].alignment = LEFT\n    ws['C18'] = '=C7*INDEX(B14:B16,MATCH(C12,A14:A16,0))'\n    ws['C18'].font = font(color=BLACK, bold=True)\n    ws['C18'].number_format = '0.000'\n    ws['C18'].alignment = RIGHT\n    ws['C18'].comment = Comment(\n        'Local formula (black): published 2025 index (Summary!C7, linked to Annual!AT487) multiplied by '\n        'the selected scenario multiplier via INDEX/MATCH over the assumptions table (B14:B16 / A14:A16).',\n        'Productivity Analysis')\n\n    ws.merge_cells('A20:E20')\n    ws['A20'] = ('Note: NAICS 316 (Leather and allied products) 2025 productivity is suppressed '\n                 '(\"N.A.\") in the source and is excluded from the industry comparison chart.')\n    ws['A20'].font = NOTE_FONT\n    ws['A20'].fill = NOTE_FILL\n    ws['A20'].alignment = WRAP\n    ws.row_dimensions[20].height = 28\n    ws.merge_cells('A21:E21')\n    ws['A21'] = ('All change metrics are computed from published annual index levels; '\n                 'no missing observations are inferred or combined across industries or representations.')\n    ws['A21'].font = NOTE_FONT\n    ws['A21'].fill = NOTE_FILL\n    ws['A21'].alignment = WRAP\n    ws.row_dimensions[21].height = 28\n\n    # Conditional formatting on Summary\n    ws.conditional_formattin