#!/usr/bin/env python3
"""Build retail_enhanced.xlsx: add an Analysis worksheet with live formulas,
scenario selector, projections, chart, conditional formatting and comments.

Original worksheets are preserved untouched (load -> add sheet -> save).
"""
import json
from pathlib import Path

from openpyxl import load_workbook
from openpyxl.chart import LineChart, Reference
from openpyxl.comments import Comment
from openpyxl.formatting.rule import CellIsRule, DataBarRule
from openpyxl.styles import Alignment, Border, Font, PatternFill, Side
from openpyxl.worksheet.datavalidation import DataValidation

HERE = Path(__file__).resolve().parent
SRC = HERE / 'input/marts_table1_202608.xlsx'
OUT = HERE / 'output/retail_enhanced.xlsx'
FEATURES = HERE / 'output/workbook_features.json'

SRC_SHEET = 'MARTS Table 1'

# --- Skill colour conventions (editable inputs blue, cross-sheet green, local black)
BLUE = Font(color='FF0000FF')
GREEN = Font(color='FF008000')
BLACK = Font(color='FF000000')
BOLD = Font(bold=True, color='FF000000')
TITLE = Font(bold=True, size=14, color='FF1F3864')
SUB = Font(italic=True, size=9, color='FF595959')
HDR = Font(bold=True, color='FF1F3864')
HDR_FILL = PatternFill('solid', fgColor='FFD9E1F2')
THIN = Side(style='thin', color='FFBFBFBF')
BORDER = Border(left=THIN, right=THIN, top=THIN, bottom=THIN)


def style_header(ws, ref, fill=True):
    for row in ws[ref]:
        for c in row:
            c.font = HDR
            if fill:
                c.fill = HDR_FILL
            c.border = BORDER
            c.alignment = Alignment(horizontal='left', vertical='center')


def main():
    wb = load_workbook(SRC)
    ws = wb.create_sheet('Analysis')

    # Titles / notes
    ws['A1'] = 'MARTS August 2026 - Retail & Food Services Sales Analysis'
    ws['A1'].font = TITLE
    ws.merge_cells('A1:F1')
    ws['A2'] = ('Source: U.S. Census Bureau, Advance Monthly Retail Trade Survey, '
                'Table 1 (release CB26-153, Sep 16 2026); frozen pre-revision estimates, USD millions.')
    ws['A2'].font = SUB
    ws.merge_cells('A2:F2')

    # ---- Key metrics -------------------------------------------------------
    ws['A4'] = 'Key Metrics'
    ws['A4'].font = HDR
    ws['A5'], ws['B5'], ws['C5'], ws['D5'] = 'Metric', 'Value', 'Unit', 'Note'
    style_header(ws, 'A5:D5')

    ws['A6'] = 'Adjusted retail & food services sales, SA Aug 2026'
    ws['B6'] = f"='{SRC_SHEET}'!I2"
    ws['C6'] = 'USD million'
    ws['D6'] = 'Published total (not a sum of overlapping categories)'

    ws['A7'] = 'Month-over-month growth (Jul 2026 to Aug 2026)'
    ws['B7'] = f"=('{SRC_SHEET}'!I2-'{SRC_SHEET}'!J2)/'{SRC_SHEET}'!J2"
    ws['C7'] = 'fraction'
    ws['D7'] = 'Computed from SA levels, not published rounded percent'

    ws['A8'] = 'Year-over-year growth (Aug 2025 to Aug 2026)'
    ws['B8'] = f"=('{SRC_SHEET}'!I2-'{SRC_SHEET}'!L2)/'{SRC_SHEET}'!L2"
    ws['C8'] = 'fraction'
    ws['D8'] = 'Computed from SA levels'

    for coord in ('B6', 'B7', 'B8'):
        ws[coord].font = GREEN            # cross-sheet formulas
        ws[coord].border = BORDER
    ws['B6'].number_format = '#,##0'
    ws['B7'].number_format = '0.0%'
    ws['B8'].number_format = '0.0%'
    for coord in ('A6', 'A7', 'A8', 'C6', 'C7', 'C8', 'D6', 'D7', 'D8'):
        ws[coord].border = BORDER

    # ---- Scenario ----------------------------------------------------------
    ws['A10'] = 'Scenario Analysis'
    ws['A10'].font = HDR
    ws['A11'] = 'Selected scenario:'
    ws['B11'] = 'Base'
    ws['B11'].font = BLUE                 # editable input
    ws['B11'].fill = PatternFill('solid', fgColor='FFFFF2CC')
    ws['B11'].border = BORDER
    ws['B11'].alignment = Alignment(horizontal='center')

    dv = DataValidation(type='list', formula1='"Base,Higher,Lower"', allow_blank=False,
                        showDropDown=False)
    dv.prompt = 'Choose a scenario'
    dv.promptTitle = 'Scenario'
    ws.add_data_validation(dv)
    dv.add(ws['B11'])

    ws['A12'] = 'Hypothetical sales level multiplier applied to the published total; not a Census forecast.'
    ws['A12'].font = SUB

    ws['A13'], ws['B13'] = 'Scenario', 'Sales multiplier'
    style_header(ws, 'A13:B13')
    scenarios = [('Base', 1), ('Higher', 1.04), ('Lower', 0.96)]
    for i, (name, mult) in enumerate(scenarios):
        r = 14 + i
        ws.cell(row=r, column=1, value=name).border = BORDER
        mc = ws.cell(row=r, column=2, value=mult)
        mc.font = BLUE                    # editable assumption input
        mc.number_format = '0.00'
        mc.border = BORDER
        mc.alignment = Alignment(horizontal='center')

    # ---- Projection --------------------------------------------------------
    ws['A18'] = 'Projected adjusted sales (selected scenario):'
    ws['A18'].font = BOLD
    ws['B18'] = '=B6*INDEX($B$14:$B$16,MATCH($B$11,$A$14:$A$16,0))'
    ws['B18'].font = BLACK                # local formula
    ws['B18'].number_format = '#,##0'
    ws['B18'].border = BORDER
    ws['C18'] = 'USD million'

    # ---- Chart data (cross-sheet links, green) -----------------------------
    ws['A20'] = 'Adjusted total sales trend, Jun-Aug 2026 (SA)'
    ws['A20'].font = HDR
    ws['A21'], ws['B21'] = 'Month', 'Adjusted sales (USD million)'
    style_header(ws, 'A21:B21')
    trend = [('Jun 2026', 'K2'), ('Jul 2026', 'J2'), ('Aug 2026', 'I2')]
    for i, (label, ref) in enumerate(trend):
        r = 22 + i
        ws.cell(row=r, column=1, value=label).border = BORDER
        c = ws.cell(row=r, column=2, value=f"='{SRC_SHEET}'!{ref}")
        c.font = GREEN
        c.number_format = '#,##0'
        c.border = BORDER

    # ---- Chart -------------------------------------------------------------
    chart = LineChart()
    chart.title = 'Adjusted total sales, Jun-Aug 2026 (SA)'
    chart.style = 2
    data = Reference(ws, min_col=2, min_row=21, max_row=24)
    cats = Reference(ws, min_col=1, min_row=22, max_row=24)
    chart.add_data(data, titles_from_data=True)
    chart.set_categories(cats)
    chart.y_axis.title = 'USD million'
    chart.x_axis.title = 'Month'
    chart.height = 8
    chart.width = 14
    ws.add_chart(chart, 'F5')

    # ---- Conditional formatting (>=2 rules on added sheet) -----------------
    ws.conditional_formatting.add(
        'B7:B8', CellIsRule(operator='greaterThan', formula=['0'],
                            fill=PatternFill('solid', fgColor='FFC6EFCE'),
                            font=Font(color='FF006100')))
    ws.conditional_formatting.add(
        'B7:B8', CellIsRule(operator='lessThan', formula=['0'],
                            fill=PatternFill('solid', fgColor='FFFFC7CE'),
                            font=Font(color='FF9C0006')))
    ws.conditional_formatting.add(
        'B22:B24', DataBarRule(start_type='min', end_type='max', color='FF638EC6'))

    # ---- Comments (>=2 on added sheet) -------------------------------------
    ws['A6'].comment = Comment(
        "Source: U.S. Census Bureau, MARTS Table 1, column 'SA Aug 2026', row "
        "'Retail & food services, total'. Frozen publication, USD millions.", 'Analyst')
    ws['B11'].comment = Comment(
        "Editable input: select Base/Higher/Lower. Drives the projected sales figure below.",
        'Analyst')
    ws['B14'].comment = Comment(
        "Hypothetical sales multiplier (editable assumption). Not a Census forecast.", 'Analyst')

    # ---- Layout ------------------------------------------------------------
    widths = {'A': 46, 'B': 22, 'C': 14, 'D': 44, 'E': 3, 'F': 16, 'G': 16}
    for col, w in widths.items():
        ws.column_dimensions[col].width = w
    ws.freeze_panes = 'A5'

    OUT.parent.mkdir(parents=True, exist_ok=True)
    wb.save(OUT)

    features = {
        "summary_sheet": "Analysis",
        "metrics": {
            "adjusted_sales": {"sheet": "Analysis", "cell": "B6"},
            "monthly_growth": {"sheet": "Analysis", "cell": "B7"},
            "annual_growth": {"sheet": "Analysis", "cell": "B8"},
        },
        "scenario": {
            "selector": {"sheet": "Analysis", "cell": "B11"},
            "assumptions": {
                "Base": {"sales_multiplier": {"sheet": "Analysis", "cell": "B14"}},
                "Higher": {"sales_multiplier": {"sheet": "Analysis", "cell": "B15"}},
                "Lower": {"sales_multiplier": {"sheet": "Analysis", "cell": "B16"}},
            },
            "projections": {
                "projected_sales": {"sheet": "Analysis", "cell": "B18"},
            },
        },
        "charts": {
            "adjusted_trend": {"sheet": "Analysis", "index": 0},
        },
    }
    FEATURES.write_text(json.dumps(features, indent=2) + '\n', encoding='utf-8')
    print('wrote', OUT)
    print('wrote', FEATURES)


if __name__ == '__main__':
    main()
