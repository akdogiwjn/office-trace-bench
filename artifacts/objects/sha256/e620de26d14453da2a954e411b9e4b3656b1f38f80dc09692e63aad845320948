#!/usr/bin/env python3
"""Write reference deliverables metrics.csv and scenario.csv.

Values are read from the recalculated workbook cache (data_only pass) so they
match the formula results exactly. Row order follows workbook_features.json.
Header: ['metric', 'value'].
"""
import csv
import json
import sys
from pathlib import Path

sys.path.insert(0, '/workspace/vendor/wheels/openpyxl-3.1.5-py2.py3-none-any.whl')
from openpyxl import load_workbook

ROOT = Path(__file__).resolve().parents[1]
OUTPUT = ROOT / 'output/industry_productivity_enhanced.xlsx'
FEATURES = json.loads((ROOT / 'output/workbook_features.json').read_text())
METRICS_CSV = ROOT / 'output/metrics.csv'
SCENARIO_CSV = ROOT / 'output/scenario.csv'


def cached_value(book, location):
    sheet, cell = location['sheet'], location['cell']
    return book[sheet][cell].value


def main():
    wb = load_workbook(OUTPUT, data_only=True, read_only=True)
    rows = []
    for metric_id, loc in FEATURES['metrics'].items():
        rows.append([metric_id, cached_value(wb, loc)])
    with METRICS_CSV.open('w', newline='') as f:
        writer = csv.writer(f)
        writer.writerow(['metric', 'value'])
        writer.writerows(rows)
    print('metrics.csv:', rows, flush=True)

    proj_rows = []
    for proj_id, loc in FEATURES['scenario']['projections'].items():
        proj_rows.append([proj_id, cached_value(wb, loc)])
    with SCENARIO_CSV.open('w', newline='') as f:
        writer = csv.writer(f)
        writer.writerow(['metric', 'value'])
        writer.writerows(proj_rows)
    print('scenario.csv:', proj_rows, flush=True)
    wb.close()


if __name__ == '__main__':
    main()
